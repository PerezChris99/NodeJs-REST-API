{
  "name": "nodejs-rest-api",
  "version": "2.0.0",
  "description": "A production-ready RESTful API built with vanilla Node.js featuring validation, security, logging, and health checks",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "lint": "echo 'Add ESLint for production'",
    "docker:build": "docker build -t nodejs-rest-api .",
    "docker:run": "docker run -p 5000:5000 --env-file .env nodejs-rest-api"
  },
  "keywords": [
    "nodejs",
    "rest-api",
    "crud",
    "products",
    "vanilla-nodejs",
    "no-framework"
  ],
  "author": "PerezChris99",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/PerezChris99/NodeJs-REST-API.git"
  },
  "devDependencies": {
    "nodemon": "^3.1.2"
  },
  "dependencies": {
    "uuid": "^9.0.1"
  }
}
